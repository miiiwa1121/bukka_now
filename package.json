{
  "name": "bukka_now",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && tsx scripts/seo/prerender.ts",
    "preview": "wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "db:migrate:local": "echo y | wrangler d1 migrations apply bukka-now-db --local",
    "db:migrate:remote": "echo y | wrangler d1 migrations apply bukka-now-db --remote",
    "synthetic:generate": "tsx scripts/synthetic-data/generate.ts",
    "synthetic:insert:local": "wrangler d1 execute bukka-now-db --local --file scripts/synthetic-data/out/insert.sql",
    "synthetic:insert:remote": "wrangler d1 execute bukka-now-db --remote --file scripts/synthetic-data/out/insert.sql",
    "synthetic:delete:local": "wrangler d1 execute bukka-now-db --local --file scripts/synthetic-data/delete.sql",
    "synthetic:delete:remote": "wrangler d1 execute bukka-now-db --remote --file scripts/synthetic-data/delete.sql",
    "seo:images": "tsx scripts/seo/render-images.ts",
    "lint": "oxlint"
  },
  "dependencies": {
    "hono": "^4.13.13",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261010.1",
    "@hono/vite-dev-server": "^0.26.1",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "canvas-confetti": "^1.9.4",
    "oxlint": "^1.81.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "wrangler": "^4.149.0"
  }
}
